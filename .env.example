# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / VITE_APP_URL: The public application URL where the frontend is hosted (e.g. https://duomation.vercel.app)
# Used for generating QR Code pairing links and direct sharing links.
VITE_APP_URL=https://duomation.vercel.app
APP_URL=https://duomation.vercel.app

# VITE_SOCKET_URL: The persistent Socket.IO server URL (e.g. https://duomation-realtime.onrender.com)
# REQUIRED in production so Vercel frontend can connect to the standalone Node/Socket.IO backend.
VITE_SOCKET_URL=https://YOUR_PERSISTENT_SOCKET_SERVER_DOMAIN

# CLIENT_ORIGIN / CORS_ORIGIN: Allowed frontend origin on the Node/Socket.IO backend server (e.g. https://duomation.vercel.app)
CLIENT_ORIGIN=https://duomation.vercel.app
CORS_ORIGIN=https://duomation.vercel.app

